# Copie para .env e ajuste. Se DB_NAME não for definido, o projeto usa SQLite (arquivo vetor.db).
# Para forçar o SQLite mesmo com DB_NAME definido, rode antes: $env:DB_ENGINE="sqlite"  (PowerShell)
SECRET_KEY=troque-esta-chave
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=vetor
DB_USER=postgres
DB_PASSWORD=sua_senha
DB_HOST=localhost
DB_PORT=5432
